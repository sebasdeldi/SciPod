<div class="devise-page">
  <div class="devise-form-container">
    <!-- Header Section -->
    <div class="devise-header">
      <div class="devise-icon">
        <i class="fas fa-shield-alt"></i>
      </div>
      <h2>New Password</h2>
    </div>

    <!-- Form Content -->
    <div class="devise-form-content">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="field">
          <%= f.label :password, "New Password" %>
          <div class="input-wrapper">
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "Enter your new password" %>
            <i class="fas fa-lock input-icon"></i>
          </div>
          <% if @minimum_password_length %>
            <div class="password-requirements">
              <i class="fas fa-info-circle"></i>
              <span><%= @minimum_password_length %> characters minimum</span>
            </div>
          <% end %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, "Confirm New Password" %>
          <div class="input-wrapper">
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm your new password" %>
            <i class="fas fa-lock input-icon"></i>
          </div>
        </div>

        <div class="actions">
          <%= f.submit "Update Password", class: "auth-submit-btn" %>
        </div>
      <% end %>
    </div>

    <!-- Links Section -->
    <div class="devise-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
