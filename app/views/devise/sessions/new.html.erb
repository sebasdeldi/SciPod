<div class="devise-page">
  <div class="devise-form-container">
    <!-- Header Section -->
    <div class="devise-header">
      <div class="devise-icon">
        <i class="fas fa-sign-in-alt"></i>
      </div>
      <h2>Welcome Back</h2>
    </div>

    <!-- Form Content -->
    <div class="devise-form-content">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="field">
          <%= f.label :email, "Email Address" %>
          <div class="input-wrapper">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Enter your email" %>
            <i class="fas fa-envelope input-icon"></i>
          </div>
        </div>

        <div class="field">
          <%= f.label :password, "Password" %>
          <div class="input-wrapper">
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password" %>
            <i class="fas fa-lock input-icon"></i>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="checkbox-field">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me, "Keep me signed in" %>
          </div>
        <% end %>

        <div class="actions">
          <%= f.submit "Sign In", class: "auth-submit-btn", data: { disable_with: "Signing in..." } %>
        </div>
      <% end %>
    </div>

    <!-- Links Section -->
    <div class="devise-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
