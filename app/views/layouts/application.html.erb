<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Scipod" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <!-- Navigation Header -->
    <header class="main-header">
      <nav class="nav-container">
        <%= link_to "Podcast AI", root_path, class: "logo" %>

        <!-- Search Bar (prominent on main pages) -->
                  <% unless current_page?(new_podcast_path) %>
          <div class="search-container">
            <%= form_with url: search_podcasts_path, method: :get,
                          data: {
                            turbo_frame: "search_results",
                            turbo_action: "advance"
                          },
                          class: "search-form" do |form| %>
              <%= form.text_field :query,
                                  placeholder: "Search podcasts, authors, publishers...",
                                  value: params[:query],
                                  class: "search-input",
                                  autocomplete: "off",
                                  data: {
                                    action: "input->search#perform",
                                    search_target: "input"
                                  } %>
              <%= form.submit "Search", class: "search-button" %>
            <% end %>
          </div>
        <% end %>

        <!-- User Navigation -->
        <div class="user-nav">
          <% if user_signed_in? %>
            <%= link_to "Create Podcast", new_podcast_path, class: "btn-primary" %>
            <div class="user-menu">
              <span class="user-email"><%= current_user.email %></span>
              <div class="user-dropdown">
                <%= link_to "My Podcasts", my_podcasts_user_path(current_user) %>
                <%= link_to "My Favorites", favorites_user_path(current_user) %>
                <%= link_to "Profile", user_path(current_user) %>
                                    <%= link_to "Logout", destroy_user_session_path, data: { "turbo-method": :delete } %>
              </div>
            </div>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "btn-secondary" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "btn-primary" %>
          <% end %>
        </div>
      </nav>
    </header>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="flash notice" data-controller="flash" data-action="click->flash#dismiss">
        <%= notice %>
        <button data-action="click->flash#dismiss">&times;</button>
      </div>
    <% end %>
    <% if alert %>
      <div class="flash alert" data-controller="flash" data-action="click->flash#dismiss">
        <%= alert %>
        <button data-action="click->flash#dismiss">&times;</button>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="main-content">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="main-footer">
      <div class="footer-content">
        <p>&copy; 2025 Podcast AI. Convert your PDFs to engaging podcasts.</p>
      </div>
    </footer>
  </body>
</html>
