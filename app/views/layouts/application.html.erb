          <% end %>
        </div>
      </nav>
    </header>
    -->

    <!-- Government-Style Search Header -->
    <header class="top-search-section">
      <div class="search-container">
        <label for="main-search" class="search-label">Search by:</label>
        <%= form_with url: root_path, method: :get,
                      data: { turbo_frame: "search_results" },
                      class: "main-search-form",
                      local: true do |form| %>
          <div class="main-search-input-container">
            <%= form.text_field :query,
                                id: "main-search",
                                placeholder: "DOI, ISSN, title, or authors...",
                                value: params[:query],
                                class: "main-search-input",
                                autocomplete: "off" %>
            <button type="submit" class="search-icon-btn">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
              </svg>
            </button>
          </div>
        <% end %>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if notice %>
      <div class="flash notice" data-controller="flash" data-action="click->flash#dismiss">
        <%= notice %>
        <button data-action="click->flash#dismiss">&times;</button>
      </div>
    <% end %>
    <% if alert %>
      <div class="flash alert" data-controller="flash" data-action="click->flash#dismiss">
        <%= alert %>
        <button data-action="click->flash#dismiss">&times;</button>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="main-content" data-controller="page-transition">
      <%= yield %>
    </main>
  </body>
</html>
