<!-- Flash Messages Container -->
<div class="flash-messages-container">
  <% if notice %>
    <div class="flash notice" data-controller="flash" data-flash-duration-value="5000">
      <i class="fas fa-check-circle flash-icon"></i>
      <div class="flash-content"><%= notice %></div>
      <button class="flash-close" data-action="click->flash#dismiss">
        <i class="fas fa-times"></i>
      </button>
      <div class="flash-progress"></div>
    </div>
  <% end %>
  
  <% if alert %>
    <div class="flash alert" data-controller="flash" data-flash-duration-value="5000">
      <i class="fas fa-exclamation-triangle flash-icon"></i>
      <div class="flash-content"><%= alert %></div>
      <button class="flash-close" data-action="click->flash#dismiss">
        <i class="fas fa-times"></i>
      </button>
      <div class="flash-progress"></div>
    </div>
  <% end %>
  
  <% flash.each do |type, message| %>
    <% next if type.to_s.in?(['notice', 'alert']) %>
    <div class="flash <%= type %>" data-controller="flash" data-flash-duration-value="5000">
      <% case type.to_s %>
      <% when 'info' %>
        <i class="fas fa-info-circle flash-icon"></i>
      <% when 'warning' %>
        <i class="fas fa-exclamation-triangle flash-icon"></i>
      <% else %>
        <i class="fas fa-bell flash-icon"></i>
      <% end %>
      <div class="flash-content"><%= message %></div>
      <button class="flash-close" data-action="click->flash#dismiss">
        <i class="fas fa-times"></i>
      </button>
      <div class="flash-progress"></div>
    </div>
  <% end %>
</div>
