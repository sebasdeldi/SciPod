<%
  # Determine context - all contexts now use the same structure
  context = params[:action] == 'home' ? 'search' : 'card'
%>

<% if current_user&.favorited?(podcast) %>
  <%= form_with url: unfavorite_podcast_path(podcast),
                method: :delete,
                local: false,
                class: "favorite-form",
                data: {
                  turbo_stream: true
                } do |form| %>
    <%= form.hidden_field :query, value: params[:query] if params[:query].present? %>
    <%= form.hidden_field "from_#{context}", value: true %>
    <%= form.button type: "submit", class: "favorite-button favorited", title: "Remove from favorites" do %>
      <i class="fa-solid fa-bookmark"></i>
    <% end %>
  <% end %>
<% else %>
  <%= form_with url: favorite_podcast_path(podcast),
                method: :post,
                local: false,
                class: "favorite-form",
                data: {
                  turbo_stream: true
                } do |form| %>
    <%= form.hidden_field :query, value: params[:query] if params[:query].present? %>
    <%= form.hidden_field "from_#{context}", value: true %>
    <%= form.button type: "submit", class: "favorite-button not-favorited", title: "Add to favorites" do %>
      <i class="fa-regular fa-bookmark"></i>
    <% end %>
  <% end %>
<% end %>
