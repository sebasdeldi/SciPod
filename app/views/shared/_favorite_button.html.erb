<% 
  # Determine context based on where this is being rendered
  context = if controller_name == 'podcasts' && action_name == 'show'
              'show'
            elsif params[:action] == 'home' || defined?(turbo_frame_request_id)
              'search'
            else
              'card'
            end
%>

<% if current_user&.favorited?(podcast) %>
  <%= form_with url: unfavorite_podcast_path(podcast),
                method: :delete,
                local: false,
                class: "favorite-form",
                data: { 
                  turbo_stream: true 
                } do |form| %>
    <%= form.hidden_field :query, value: params[:query] if params[:query].present? %>
    <%= form.hidden_field "from_#{context}", value: true %>
    <%= form.submit "❤️", 
                    class: "favorite-button favorited",
                    title: "Remove from favorites" %>
  <% end %>
<% else %>
  <%= form_with url: favorite_podcast_path(podcast),
                method: :post,
                local: false,
                class: "favorite-form",
                data: { 
                  turbo_stream: true 
                } do |form| %>
    <%= form.hidden_field :query, value: params[:query] if params[:query].present? %>
    <%= form.hidden_field "from_#{context}", value: true %>
    <%= form.submit "🤍",
                    class: "favorite-button not-favorited", 
                    title: "Add to favorites" %>
  <% end %>
<% end %>
