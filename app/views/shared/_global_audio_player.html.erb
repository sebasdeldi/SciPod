<div id="global-audio-player" 
     class="global-audio-player" 
     data-controller="global-audio-player">
  
  <div class="player-content">
    <!-- Left section: Title with marquee -->
    <div class="player-title-section">
      <div class="player-title-container">
        <h4 class="player-title" data-global-audio-player-target="title"></h4>
      </div>
      <div class="player-authors-container">
        <div class="player-authors" data-global-audio-player-target="authors"></div>
      </div>
      <div class="player-time-container">
        <div class="player-time-display" data-global-audio-player-target="timeDisplay">
          <span data-global-audio-player-target="currentTime">0:00</span>
          <span class="time-separator">-</span>
          <span data-global-audio-player-target="totalTime">0:00</span>
        </div>
      </div>
    </div>
    
    <!-- Center section: Play/Pause button -->
    <div class="player-controls-section">
      <button class="player-play-pause-btn" 
              data-action="click->global-audio-player#togglePlayPause"
              data-global-audio-player-target="playPauseBtn">
        <i class="fa-solid fa-play" data-global-audio-player-target="playPauseIcon"></i>
      </button>
      
      <!-- Favorite Button -->
      <div id="global-player-favorite" 
           data-global-audio-player-target="favoriteContainer">
        <!-- Will be populated by JavaScript when podcast loads -->
      </div>
    </div>
    
    <!-- Right section: Speed controls -->
    <div class="player-options-section">
      <div class="player-speed-control">
        <button class="speed-btn" 
                data-action="click->global-audio-player#toggleSpeedDropdown"
                data-global-audio-player-target="speedBtn">
          <span data-global-audio-player-target="speedText">1x</span>
          <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="speed-dropdown" data-global-audio-player-target="speedDropdown">
          <button class="speed-option" 
                  data-action="click->global-audio-player#setSpeed"
                  data-speed="0.75">0.75x</button>
          <button class="speed-option" 
                  data-action="click->global-audio-player#setSpeed"
                  data-speed="1">1x</button>
          <button class="speed-option" 
                  data-action="click->global-audio-player#setSpeed"
                  data-speed="1.5">1.5x</button>
          <button class="speed-option" 
                  data-action="click->global-audio-player#setSpeed"
                  data-speed="2">2x</button>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Bottom Border Progress Line -->
  <div class="player-progress-border" 
       data-action="click->global-audio-player#seekTo"
       data-global-audio-player-target="progressContainer">
    <div class="progress-line" data-global-audio-player-target="progressBar"></div>
  </div>
  
  <!-- Hidden audio element -->
  <audio data-global-audio-player-target="audio" 
         data-action="ended->global-audio-player#onAudioEnded loadedmetadata->global-audio-player#onAudioLoaded timeupdate->global-audio-player#onTimeUpdate">
  </audio>
</div> 