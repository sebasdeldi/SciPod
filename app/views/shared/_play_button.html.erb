<%# Only show play button if audio is available %>
<% if podcast.audio_available? %>
  <button type="button" 
          class="play-button"
          title="Play podcast"
          data-inline-audio-target="playButton"
          data-action="click->inline-audio#play">
    <i class="fa-solid fa-play" data-inline-audio-target="icon"></i>
  </button>
<% else %>
  <%# For podcasts without audio, show disabled state %>
  <button type="button" 
          class="play-button disabled"
          title="Audio not available"
          disabled>
    <i class="fa-solid fa-play"></i>
  </button>
<% end %> 