<!-- The main floating navigation bar -->
<nav class="floating-nav-bar" data-controller="bottom-navigation">
  <ul>
    <!-- Navigation Item: Home/Discover -->
    <li class="<%= 'active' if current_page?(root_path) && (!params[:tab] || params[:tab] == 'discover') %>">
      <%= link_to root_path(tab: 'discover'), data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
        <i class="fas fa-home"></i>
      <% end %>
    </li>

    <!-- Navigation Item: By Me -->
    <li class="<%= 'active' if params[:tab] == 'by_me' %>">
      <%= link_to root_path(tab: 'by_me'), data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
        <i class="fas fa-microphone"></i>
      <% end %>
    </li>

    <!-- Navigation Item: Bookmarks -->
    <li class="<%= 'active' if params[:tab] == 'bookmarks' %>">
      <%= link_to root_path(tab: 'bookmarks'), data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
        <i class="fas fa-bookmark"></i>
      <% end %>
    </li>

    <!-- Navigation Item: Profile -->
    <li class="<%= 'active' if current_page?(user_path(current_user)) %>">
      <%= link_to user_path(current_user), data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
        <i class="fas fa-user"></i>
      <% end %>
    </li>
  </ul>
</nav>
