<!-- The main floating navigation bar -->
<nav class="floating-nav-bar" data-controller="bottom-navigation">
  <ul>
    <!-- Navigation Item: Home -->
    <li class="<%= 'active' if current_page?(root_path) %>">
      <%= link_to root_path, data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
        <i class="fas fa-home"></i>
        <span>Home</span>
      <% end %>
    </li>
    
    <% if user_signed_in? %>
      <!-- Navigation Item: My Podcasts -->
      <li class="<%= 'active' if current_page?(my_podcasts_user_path(current_user)) %>">
        <%= link_to my_podcasts_user_path(current_user), data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
          <i class="fas fa-microphone"></i>
          <span>My Podcasts</span>
        <% end %>
      </li>
      
      <!-- Navigation Item: Favorites -->
      <li class="<%= 'active' if current_page?(favorites_user_path(current_user)) %>">
        <%= link_to favorites_user_path(current_user), data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
          <i class="fas fa-bookmark"></i>
          <span>Favorites</span>
        <% end %>
      </li>
      
      <!-- Navigation Item: Profile -->
      <li class="<%= 'active' if current_page?(user_path(current_user)) %>">
        <%= link_to user_path(current_user), data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
          <i class="fas fa-user"></i>
          <span>Profile</span>
        <% end %>
      </li>
    <% else %>
      <!-- Navigation Item: Login -->
      <li class="<%= 'active' if current_page?(new_user_session_path) %>">
        <%= link_to new_user_session_path, data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
          <i class="fas fa-sign-in-alt"></i>
          <span>Login</span>
        <% end %>
      </li>
      
      <!-- Navigation Item: Sign Up -->
      <li class="<%= 'active' if current_page?(new_user_registration_path) %>">
        <%= link_to new_user_registration_path, data: { action: "click->bottom-navigation#preventActiveNavigation" } do %>
          <i class="fas fa-user-plus"></i>
          <span>Sign Up</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</nav> 