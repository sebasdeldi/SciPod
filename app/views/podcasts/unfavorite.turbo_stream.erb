<%# Update the favorite button %>
<%= turbo_stream.replace "favorite_button_#{@podcast.id}" do %>
  <div id="favorite_button_<%= @podcast.id %>" class="result-favorite">
    <%= render 'shared/favorite_button', podcast: @podcast, current_user: current_user %>
    <% if params[:from_search] || params[:from_card] %>
      <span id="search_favorites_count_<%= @podcast.id %>" class="result-favorites-count">
        <%= formatted_favorites_count(@podcast.favorites_count) %>
      </span>
    <% end %>
  </div>
<% end %>

 