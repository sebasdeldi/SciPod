<% content_for :title, "Edit #{@podcast.title} - Scipod" %>

<div class="podcast-form-page">
  <div class="form-header">
    <h1>Edit Podcast</h1>
    <p class="form-description">
      Update your podcast details and files.
    </p>
  </div>

  <%= form_with model: @podcast,
                data: { controller: "podcast-form" },
                multipart: true,
                class: "podcast-form" do |form| %>

    <% if @podcast.errors.any? %>
      <div class="error-messages">
        <h3><%= pluralize(@podcast.errors.count, "error") %> prohibited this podcast from being saved:</h3>
        <ul>
          <% @podcast.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Basic Information -->
    <section class="form-section">
      <h2>Basic Information</h2>

      <div class="form-group">
        <%= form.label :title, class: "form-label required" %>
        <%= form.text_field :title,
                           class: "form-input",
                           placeholder: "Enter a descriptive title for your podcast",
                           required: true %>
        <span class="field-hint">This will be the main title displayed to listeners</span>
      </div>

      <div class="form-group">
        <%= form.label :summary, "Summary (Optional)", class: "form-label" %>
        <%= form.text_area :summary,
                          class: "form-textarea",
                          rows: 4,
                          placeholder: "Provide a brief summary of the content..." %>
        <span class="field-hint">A short description that will help others understand the content</span>
      </div>
    </section>

    <!-- Current Files -->
    <section class="form-section">
      <h2>Current Files</h2>

      <% if @podcast.source_file.attached? %>
        <div class="current-file">
          <h4>Source PDF Document</h4>
          <div class="file-info">
            <span class="file-icon">📄</span>
            <span class="file-name"><%= @podcast.source_file.filename %></span>
            <span class="file-size">(<%= number_to_human_size(@podcast.source_file.byte_size) %>)</span>
          </div>
          <%= link_to "Download", rails_blob_path(@podcast.source_file, disposition: "attachment"),
                     class: "btn-secondary btn-small" %>
        </div>
      <% end %>

      <% if @podcast.audio.attached? %>
        <div class="current-file">
          <h4>Audio File</h4>
          <div class="file-info">
            <span class="file-icon">🎵</span>
            <span class="file-name"><%= @podcast.audio.filename %></span>
            <span class="file-size">(<%= number_to_human_size(@podcast.audio.byte_size) %>)</span>
          </div>
          <audio controls class="current-audio">
            <%= audio_tag rails_blob_path(@podcast.audio, disposition: "inline") %>
          </audio>
        </div>
      <% end %>
    </section>

    <!-- File Uploads -->
    <section class="form-section">
      <h2>Update Files</h2>

      <div class="form-group">
        <%= form.label :source_file, "Replace Source PDF Document", class: "form-label" %>
        <%= form.file_field :source_file,
                           class: "form-file-input",
                           accept: "application/pdf",
                           data: {
                             action: "change->podcast-form#validateFile",
                             podcast_form_target: "sourceFile"
                           } %>
        <span class="field-hint">Upload a new PDF to replace the current one (max 50MB)</span>
        <div class="file-preview" data-podcast-form-target="sourcePreview"></div>
      </div>

      <div class="form-group">
        <%= form.label :audio, "Replace Audio File", class: "form-label" %>
        <%= form.file_field :audio,
                           class: "form-file-input",
                           accept: "audio/*",
                           data: {
                             action: "change->podcast-form#validateFile",
                             podcast_form_target: "audioFile"
                           } %>
        <span class="field-hint">Upload a new audio file to replace the current one (max 100MB)</span>
        <div class="file-preview" data-podcast-form-target="audioPreview"></div>
      </div>
    </section>

    <!-- Metadata -->
    <section class="form-section">
      <h2>Publication Details (Optional)</h2>

      <div class="form-row">
        <div class="form-group">
          <%= form.label :issn, "ISSN", class: "form-label" %>
          <%= form.text_field :issn,
                             class: "form-input",
                             placeholder: "e.g., 1234-5678" %>
          <span class="field-hint">International Standard Serial Number</span>
        </div>

        <div class="form-group">
          <%= form.label :doi, "DOI", class: "form-label" %>
          <%= form.text_field :doi,
                             class: "form-input",
                             placeholder: "e.g., 10.1000/182" %>
          <span class="field-hint">Digital Object Identifier</span>
        </div>
      </div>
    </section>

    <!-- Authors -->
    <section class="form-section">
      <h2>Authors</h2>
      <div class="form-group">
        <%= form.label :author_ids, "Select Authors", class: "form-label" %>
        <%= form.collection_check_boxes :author_ids, @authors, :id, :name,
                                        {},
                                        { class: "form-checkbox" } do |b| %>
          <div class="checkbox-item">
            <%= b.check_box(class: "checkbox-input") %>
            <%= b.label(class: "checkbox-label") %>
          </div>
        <% end %>
        <span class="field-hint">Select the authors of the source material</span>
      </div>
    </section>

    <!-- Publishers -->
    <section class="form-section">
      <h2>Publishers</h2>
      <div class="form-group">
        <%= form.label :publisher_ids, "Select Publishers", class: "form-label" %>
        <%= form.collection_check_boxes :publisher_ids, @publishers, :id, :name,
                                        {},
                                        { class: "form-checkbox" } do |b| %>
          <div class="checkbox-item">
            <%= b.check_box(class: "checkbox-input") %>
            <%= b.label(class: "checkbox-label") %>
          </div>
        <% end %>
        <span class="field-hint">Select the publishers of the source material</span>
      </div>
    </section>

    <!-- Script (Advanced) -->
    <section class="form-section advanced-section">
      <h2>Advanced Options</h2>
      <div class="form-group">
        <%= form.label :script, "Custom Script (Optional)", class: "form-label" %>
        <%= form.text_area :script,
                          class: "form-textarea",
                          rows: 8,
                          placeholder: "If you have a custom script for the podcast, enter it here..." %>
        <span class="field-hint">Leave empty to have AI generate the script from your PDF</span>
      </div>
    </section>

    <!-- Submit Actions -->
    <div class="form-actions">
      <%= form.submit "Update Podcast",
                      class: "btn-primary btn-large",
                      data: {
                        disable_with: "Updating...",
                        podcast_form_target: "submitButton"
                      } %>

      <%= link_to "Cancel", @podcast, class: "btn-secondary btn-large" %>
      <%= link_to "Delete Podcast", @podcast,
                  method: :delete,
                  class: "btn-danger btn-large",
                  confirm: "Are you sure you want to delete this podcast? This action cannot be undone." %>
    </div>
  <% end %>
</div>

<style>
  .current-file {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .current-file h4 {
    margin: 0 0 0.5rem 0;
    color: #333;
  }

  .current-file .file-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .current-audio {
    width: 100%;
    max-width: 400px;
    margin-top: 0.5rem;
  }
</style>
