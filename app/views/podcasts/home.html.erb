<% content_for :title, "Search Podcasts - Scipod" %>

<%= render 'shared/search_header' %>

<!-- Navigation Buttons -->
<div class="navigation-tabs-section" data-controller="navigation-tabs">
  <div class="navigation-tabs-container">
    <% current_tab = params[:tab] || 'discover' %>
    <%= form_with url: root_path, method: :get, data: { turbo_frame: "search_results", navigation_tabs_target: "form" }, class: "tab-form" do |form| %>
      <%= form.hidden_field :query, value: @query %>
      <% if @category_ids.present? %>
        <% @category_ids.each do |category_id| %>
          <%= form.hidden_field :category_ids, value: category_id, multiple: true %>
        <% end %>
      <% end %>
      <%= form.hidden_field :tab, value: current_tab, data: { navigation_tabs_target: "tabInput" } %>
    <% end %>
    
    <div class="navigation-tabs">
      <button type="button" 
              class="nav-tab <%= 'active' if current_tab == 'discover' %>" 
              data-action="click->navigation-tabs#switchTab"
              data-tab="discover">
        Discover
      </button>
      <% if user_signed_in? %>
        <button type="button" 
                class="nav-tab <%= 'active' if current_tab == 'bookmarks' %>" 
                data-action="click->navigation-tabs#switchTab"
                data-tab="bookmarks">
          Bookmarks
        </button>
        <button type="button" 
                class="nav-tab <%= 'active' if current_tab == 'by_me' %>" 
                data-action="click->navigation-tabs#switchTab"
                data-tab="by_me">
          By me
        </button>
      <% end %>
    </div>
  </div>
</div>

<div class="search-layout">
  <!-- Main Content Layout -->
  <div class="search-content-layout">
    <!-- Main Results Area -->
    <main class="search-results-main">
      <!-- Search Results Container -->
      <%= turbo_frame_tag "search_results" do %>
        <div id="podcasts" class="results-list">
          <% if @podcasts.any? %>
            <% @podcasts.each do |podcast| %>
              <%= render 'podcasts/components/podcast_card', podcast: podcast %>
            <% end %>
          <% else %>
            <div class="empty-results">
              <% if @query.present? || @category_ids.any? %>
                <h3>No podcasts found</h3>
                <p>Try searching with different keywords or browse all podcasts.</p>
              <% else %>
                <% case @tab %>
                <% when 'bookmarks' %>
                  <h3>No favorites yet</h3>
                  <p>Start exploring podcasts and save your favorites here.</p>
                <% when 'by_me' %>
                  <h3>No podcasts yet</h3>
                  <p>Be the first to <%= link_to "create a podcast", new_podcast_path %> from your documents!</p>
                <% else %>
                  <h3>No podcasts yet</h3>
                  <p>Be the first to <%= link_to "create a podcast", new_podcast_path %> from your documents!</p>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
        <!-- Infinite scroll cursor loader -->
        <%= render partial: "shared/cursor_loader", locals: { 
          cursor: @cursor, 
          path: root_path(
            query: @query, 
            category_ids: @category_ids,
            tab: @tab,
            before: @cursor, 
            format: :turbo_stream
          ) 
        } %>
      <% end %>
    </main>
  </div>

  <!-- Call to Action for Logged Out Users -->
  <% unless user_signed_in? %>
    <div class="cta-section">
      <div class="cta-content">
        <h2>Ready to Create Your Own Podcast?</h2>
        <p>Upload your PDF documents and let AI transform them into engaging audio content.</p>
        <div class="cta-buttons">
          <%= link_to "Get Started", new_user_registration_path, class: "btn-primary btn-large" %>
          <%= link_to "Learn More", "#", class: "btn-secondary btn-large" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
