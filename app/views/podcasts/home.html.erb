<% content_for :title, "Search Podcasts - Scipod" %>

<div class="search-layout">
  <!-- Main Content Layout -->
  <div class="search-content-layout">
    <!-- Main Results Area -->
    <main class="search-results-main">
      <!-- Search Results Container -->
      <%= turbo_frame_tag "search_results" do %>
        <div class="results-list">
          <% if @podcasts.any? %>
            <% @podcasts.each do |podcast| %>
              <div class="result-item">
                <% if podcast.ready? %>
                  <span class="result-type-badge podcast">PODCAST</span>
                <% elsif podcast.processing? %>
                  <span class="result-type-badge processing">PROCESSING</span>
                <% elsif podcast.error? %>
                  <span class="result-type-badge error">ERROR</span>
                <% elsif podcast.cancelled? %>
                  <span class="result-type-badge cancelled">CANCELLED</span>
                <% end %>
                <div class="result-header">
                  <h3 class="result-title">
                    <%= link_to podcast.title, podcast_path(podcast), class: "result-link", data: { turbo_frame: "_top" } %>
                  </h3>
                  <%= render 'shared/play_button', podcast: podcast %>
                  <div id="favorite_button_<%= podcast.id %>" class="result-favorite">
                    <% if user_signed_in? %>
                      <%= render 'shared/favorite_button', podcast: podcast, current_user: current_user %>
                    <% end %>
                    <span id="search_favorites_count_<%= podcast.id %>" class="result-favorites-count">
                      <%= formatted_favorites_count(podcast.favorites_count) %>
                    </span>
                  </div>
                </div>
                <div class="result-meta">
                  <span class="result-date"><%= podcast.created_at.strftime("%B %d, %Y") %></span>
                  <span class="result-time"><%= podcast.created_at.strftime("%l:%M%p").upcase %></span>
                </div>
                <% if podcast.summary.present? %>
                  <p class="result-summary"><%= truncate(podcast.summary, length: 200) %></p>
                <% end %>
                <% if podcast.authors.any? || podcast.publishers.any? %>
                  <div class="result-details">
                    <% if podcast.authors.any? %>
                      <span class="result-authors">Authors: <%= podcast.authors.map(&:name).join(', ') %></span>
                    <% end %>
                    <% if podcast.publishers.any? %>
                      <span class="result-publishers">Publishers: <%= podcast.publishers.map(&:name).join(', ') %></span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="empty-results">
              <% if params[:query].present? %>
                <h3>No podcasts found</h3>
                <p>Try searching with different keywords or browse all podcasts.</p>
              <% else %>
                <h3>No podcasts yet</h3>
                <p>Be the first to <%= link_to "create a podcast", new_podcast_path %> from your documents!</p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </main>
  </div>

  <!-- Call to Action for Logged Out Users -->
  <% unless user_signed_in? %>
    <div class="cta-section">
      <div class="cta-content">
        <h2>Ready to Create Your Own Podcast?</h2>
        <p>Upload your PDF documents and let AI transform them into engaging audio content.</p>
        <div class="cta-buttons">
          <%= link_to "Get Started", new_user_registration_path, class: "btn-primary btn-large" %>
          <%= link_to "Learn More", "#", class: "btn-secondary btn-large" %>
        </div>
      </div>
    </div>
  <% end %>
</div>