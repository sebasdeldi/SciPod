<% content_for :title, "Search Podcasts - Scipod" %>

<%= render 'shared/search_header' %>

<div class="search-layout">
  <!-- Main Content Layout -->
  <div class="search-content-layout">
    <!-- Main Results Area -->
    <main class="search-results-main">
      <!-- Search Results Container -->
      <%= turbo_frame_tag "search_results" do %>
        <div class="results-list">
          <% if @podcasts.any? %>
            <% @podcasts.each do |podcast| %>
              <%= render 'podcasts/components/podcast_card', podcast: podcast %>
            <% end %>
          <% else %>
            <div class="empty-results">
              <% if @query.present? || @category_ids.any? %>
                <h3>No podcasts found</h3>
                <p>Try searching with different keywords or browse all podcasts.</p>
              <% else %>
                <h3>No podcasts yet</h3>
                <p>Be the first to <%= link_to "create a podcast", new_podcast_path %> from your documents!</p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </main>
  </div>

  <!-- Call to Action for Logged Out Users -->
  <% unless user_signed_in? %>
    <div class="cta-section">
      <div class="cta-content">
        <h2>Ready to Create Your Own Podcast?</h2>
        <p>Upload your PDF documents and let AI transform them into engaging audio content.</p>
        <div class="cta-buttons">
          <%= link_to "Get Started", new_user_registration_path, class: "btn-primary btn-large" %>
          <%= link_to "Learn More", "#", class: "btn-secondary btn-large" %>
        </div>
      </div>
    </div>
  <% end %>
</div>