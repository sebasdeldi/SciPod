<% content_for :title, "My Favorites - Scipod" %>

<div class="user-dashboard">
  <div class="dashboard-header">
    <h1>My Favorites</h1>
    <p class="dashboard-description">
      Podcasts you've saved for later listening.
    </p>
  </div>

  <div class="dashboard-stats">
    <div class="stat-item">
      <span class="stat-number"><%= @podcasts.count %></span>
      <span class="stat-label">Favorited Podcasts</span>
    </div>
  </div>

  <div class="dashboard-content">
    <%= turbo_frame_tag "favorites_results" do %>
      <% if @podcasts.any? %>
        <div id="favorites" class="results-list">
          <% @podcasts.each do |podcast| %>
            <%= render 'podcasts/components/podcast_card', podcast: podcast %>
          <% end %>
        </div>
        <!-- Infinite scroll cursor loader -->
        <%= render partial: "shared/cursor_loader", locals: { 
          cursor: @cursor, 
          path: favorites_user_path(current_user, before: @cursor, format: :turbo_stream) 
        } %>
      <% else %>
        <div class="empty-state">
          <h3>No favorites yet</h3>
          <p>Start exploring podcasts and save your favorites here.</p>
          <%= link_to "Search Podcasts", root_path, class: "btn-primary" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
